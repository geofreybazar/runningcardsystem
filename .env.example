# Read by docker compose (next to docker-compose.yml). Copy to .env on the server; never commit .env.

# Public domain; its DNS A record must point at the VPS. Caddy gets the HTTPS certificate for it.
DOMAIN=

# Database password, URL-safe (it goes into DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# Google Maps browser key, restricted by HTTP referrer to https://<DOMAIN>/*
VITE_GOOGLE_API=
