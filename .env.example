# Copy this file to .env and fill in the value. Never commit .env.
#
# Google Maps API key. In Google Cloud Console, enable these APIs for the key's project:
#   - Maps JavaScript API  (map and pin)
#   - Places API (New)     (address / landmark search)
#   - Geocoding API        (barangay picker)
# Billing must be on (the monthly free allowance covers light use).
VITE_GOOGLE_API=your-google-maps-api-key
