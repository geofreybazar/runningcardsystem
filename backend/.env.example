# PostgreSQL connection. Local socket example (peer auth, no password):
#   postgresql://<user>@localhost/runningcard_dev?host=/var/run/postgresql
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/runningcard_dev
# Separate database for e2e tests (wiped on every run).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/runningcard_test

# Signs access tokens. At least 32 random bytes: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes

# The browser origin of the frontend (CORS + cookies).
FRONTEND_ORIGIN=http://localhost:5173
PORT=3000

# First Super Admin account, created by `npx prisma db seed` if it doesn't exist.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me-now

# Seed one placeholder ENGINE truck per station so the running card works before Operations adds real trucks.
SEED_PLACEHOLDER_TRUCKS=true

# Failed+successful login attempts allowed per IP per minute.
LOGIN_RATE_LIMIT=10

# Refresh cookie "Secure" flag. Defaults to true when NODE_ENV=production. Set false only when serving over plain HTTP on a trusted LAN.
# COOKIE_SECURE=false
