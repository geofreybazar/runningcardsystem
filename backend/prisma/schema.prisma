generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  OPERATIONS
  RADIO_OPERATOR
}

enum TruckType {
  ENGINE
  TANKER
  AERIAL_LADDER
  RESCUE
  AMBULANCE
  OTHER
}

enum TruckOwnership {
  BFP
  LGU
  VOLUNTEER
}

enum TruckStatus {
  AVAILABLE
  RESPONDING
  OUT_OF_SERVICE
}

/// Where an account sits in BFP NCR: the Regional office, a Fire District office, or a City office.
enum OfficeLevel {
  REGIONAL
  DISTRICT
  CITY
}

/// BFP ranks, lowest to highest (declaration order is the sort order).
enum Rank {
  FO1
  FO2
  FO3
  SFO1
  SFO2
  SFO3
  SFO4
  FINSP
  FSINSP
  FCINSP
  FSUPT
  FSSUPT
  FCSUPT
}

enum NotificationType {
  DISPATCHED
  ALARM_RAISED
  INCIDENT_CLOSED
}

enum IncidentStatus {
  OPEN
  CLOSED
}

model FireDistrict {
  id       Int       @id @default(autoincrement())
  code     Int       @unique // 1-5
  name     String // "Fire District 2"
  alias    String? // "CAMANAVA"
  color    String // hex, used for station badges
  cities   City[]
  stations Station[]
  users    User[]
}

/// FD1 (Manila) and FD5 (Quezon City) each have exactly one city; the UI skips the city step for them.
model City {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  districtId Int
  district   FireDistrict @relation(fields: [districtId], references: [id])
  barangays  Barangay[]
  stations   Station[]
  users      User[]
  incidents  Incident[]
  /// Barangay outlines of the city ({ bbox, rings }), used to tell which city a point is in.
  boundary   Json?
}

model Barangay {
  id        Int        @id @default(autoincrement())
  name      String
  cityId    Int
  city      City       @relation(fields: [cityId], references: [id])
  lat       Float? // filled on first geocode, correctable by Operations
  lng       Float?
  incidents Incident[]

  @@unique([cityId, name])
}

model Station {
  id            Int            @id @default(autoincrement())
  name          String
  lat           Float
  lng           Float
  districtId    Int
  district      FireDistrict   @relation(fields: [districtId], references: [id])
  cityId        Int?
  city          City?          @relation(fields: [cityId], references: [id])
  address       String?
  contactNumber String?
  isActive      Boolean        @default(true)
  trucks        Truck[]
  incidentUnits IncidentUnit[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([districtId])
}

model Truck {
  id                  Int            @id @default(autoincrement())
  stationId           Int
  station             Station        @relation(fields: [stationId], references: [id])
  callSign            String
  plateNumber         String?
  type                TruckType      @default(ENGINE)
  waterCapacityLiters Int?
  ownership           TruckOwnership @default(BFP)
  status              TruckStatus    @default(AVAILABLE)
  isActive            Boolean        @default(true)
  incidentUnits       IncidentUnit[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([stationId])
}

model User {
  id                  String         @id @default(uuid())
  /// BFP personnel account number (e.g. B13084), stored uppercase; it is the sign-in name.
  accountNumber       String         @unique
  rank                Rank? // required by the API for every role except SUPER_ADMIN
  firstName           String
  middleName          String?
  lastName            String
  passwordHash        String
  role                Role
  officeLevel         OfficeLevel    @default(REGIONAL)
  districtId          Int? // DISTRICT offices, and CITY offices (derived from the city)
  cityId              Int? // CITY offices
  city                City?          @relation(fields: [cityId], references: [id])
  district            FireDistrict?  @relation(fields: [districtId], references: [id])
  isActive            Boolean        @default(true)
  mustChangePassword  Boolean        @default(true)
  deletedAt           DateTime? // soft delete keeps names on incident history
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  incidentsCreated    Incident[]     @relation("IncidentCreatedBy")
  incidentsClosed     Incident[]     @relation("IncidentClosedBy")
  auditLogs           AuditLog[]
  notificationsActed  Notification[] @relation("NotificationActor")
  /// Notifications with a higher id are unread for this account (ids, not times: immune to clock steps).
  notificationsSeenId Int            @default(0)
  incidentViews       IncidentView[]
}

/// Store for @nestjs/authentication refresh-token rotation (RefreshTokenStore contract).
model RefreshToken {
  id              String    @id
  familyId        String
  userId          String
  createdAt       DateTime
  expiresAt       DateTime
  familyExpiresAt DateTime
  usedAt          DateTime?
  claims          Json?

  @@index([userId])
  @@index([familyId])
}

model RevokedRefreshFamily {
  familyId        String   @id
  familyExpiresAt DateTime
}

/// Single row (id = 1).
model Settings {
  id               Int      @id @default(1)
  stationsPerAlarm Int      @default(4)
  maxDistanceKm    Float    @default(100)
  alarmLevels      String[]
}

model Incident {
  id            String         @id @default(uuid())
  lat           Float
  lng           Float
  locationLabel String
  barangayId    Int?
  barangay      Barangay?      @relation(fields: [barangayId], references: [id])
  /// City the fire is in; its dispatchers own the incident. Null only on incidents created before offices existed.
  cityId        Int?
  city          City?          @relation(fields: [cityId], references: [id])
  status        IncidentStatus @default(OPEN)
  alarmIndex    Int            @default(0) // highest alarm level dispatched
  runningCard   Json // snapshot at dispatch
  notes         String?
  createdById   String
  createdBy     User           @relation("IncidentCreatedBy", fields: [createdById], references: [id])
  closedById    String?
  closedBy      User?          @relation("IncidentClosedBy", fields: [closedById], references: [id])
  createdAt     DateTime       @default(now())
  closedAt      DateTime?
  units         IncidentUnit[]
  notifications Notification[]
  views         IncidentView[]

  @@index([status, createdAt])
  @@index([cityId])
}

model IncidentUnit {
  id           Int       @id @default(autoincrement())
  incidentId   String
  incident     Incident  @relation(fields: [incidentId], references: [id])
  stationId    Int
  station      Station   @relation(fields: [stationId], references: [id])
  truckId      Int
  truck        Truck     @relation(fields: [truckId], references: [id])
  alarmLevel   String
  dispatchedAt DateTime  @default(now())
  releasedAt   DateTime?

  @@index([incidentId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String // CREATE | UPDATE | DELETE | DISABLE | ...
  entity    String // User | Station | Truck | Settings | Barangay
  entityId  String
  changes   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// One per incident step (dispatch, raise, close), sent to every involved city and its district office, and to the Regional office.
model Notification {
  id         Int              @id @default(autoincrement())
  incidentId String
  incident   Incident         @relation(fields: [incidentId], references: [id])
  /// Involved cities: the fire's city, cities with a truck on the incident, and cities with a station on its running card.
  cityIds    Int[]
  type       NotificationType
  alarmLevel String
  /// Trucks moved in this step: [{ station, callSign, cityId, city }] (sent, or released on close).
  units      Json
  actorId    String
  actor      User             @relation("NotificationActor", fields: [actorId], references: [id])
  createdAt  DateTime         @default(now())

  @@index([cityIds], type: Gin)
  @@index([createdAt])
}

/// An account looked at an incident: its notifications up to this id count as read.
model IncidentView {
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id])
  seenId     Int

  @@id([userId, incidentId])
}
